# ==========================================
# QuizRush Environment Configuration
# ==========================================
# QuizRush has dual-mode support:
# 1. Zero-config Local / Simulated Mode (Works right out of the box without any keys!)
# 2. Production Mode (Firebase + Stripe Monetization + Resend Email)

# --- Firebase (Google OAuth & Real-Time Sync) ---
# Get from Firebase Console -> Project Settings -> General -> Web App:
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- Stripe Monetization ($4.99 per quiz after 1 free trial) ---
# Get from https://dashboard.stripe.com/apikeys:
STRIPE_SECRET_KEY=sk_test_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# --- Resend Email Dispatch (Scorecards & Invitations) ---
# Get from https://resend.com/api-keys:
RESEND_API_KEY=re_xxxxxxxxxxxxxx

# --- Public URL (Your Vercel Domain) ---
NEXT_PUBLIC_APP_URL=https://quizrush-mu.vercel.app
