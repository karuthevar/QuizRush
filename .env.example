# ==========================================
# QuizRush Environment Configuration
# ==========================================
# QuizRush has dual-mode support:
# 1. Zero-config Local / Broadcast Mode (Works right out of the box without any keys!)
# 2. Production Firebase Mode (Multi-device internet play + Google Sign-In via Firebase Auth)

# Get these from your Firebase Console -> Project Settings -> General -> Web App:
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Public URL of the deployed app (e.g., https://quizrush.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
